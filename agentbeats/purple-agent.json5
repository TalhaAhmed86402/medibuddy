// AgentBeats Amber component manifest for the REFERENCE PURPLE agent (an example participant, for testing the
// leaderboard). Students register their own agents instead. Not yet run on the platform.
{
  manifest_version: "0.1.0",
  // No secrets for the model-free tooldemo backend. For a hosted model, add
  //   properties: { openai_api_key: { type: "string", secret: true } }, required: ["openai_api_key"]
  // here, OPENAI_API_KEY: "${config.openai_api_key}" to env, and the matching config in scenario.json5.
  config_schema: {
    type: "object",
    properties: {},
    additionalProperties: false,
  },
  program: {
    image: "ghcr.io/talhaahmed86402/medibuddy-bench-purple:1.2.0",
    // model-free plumbing check; for a hosted model replace "tooldemo" with "openai" and fill in the env below
    entrypoint: "python -m medibuddy_bench agent --backend tooldemo --host 0.0.0.0 --port 9009",
    env: {
      // OPENAI_API_KEY: "${config.openai_api_key}",
      // OPENAI_BASE_URL: "https://<an OpenAI-compatible endpoint>/v1",
      // MEDIBUDDY_MODEL: "<model id the endpoint lists>",
    },
    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },
  exports: { a2a: "a2a" },
}
